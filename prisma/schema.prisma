generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id          String   @id @default(cuid())
  tagline     String   // ex: "Creative Developer & UI Engineer"
  bio         String   @db.Text
  status      String   // ex: "Disponible pour des missions"
  location    String   // ex: "Paris, FR"
  visionTitle String   // ex: "Ma Vision"
  visionText  String   @db.Text
  photoUrl    String?
  cvUrl       String?
  metrics     Metric[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Metric {
  id        String   @id @default(cuid())
  label     String   // ex: "Années d'expérience"
  value     String   // ex: "3+"
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Skill {
  id        String   @id @default(cuid())
  name      String   // ex: "React"
  category  String   // ex: "Frontend", "Design", "Backend"
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Experience {
  id          String    @id @default(cuid())
  type        String    // ex: "Expérience", "Organisation"
  titleFr     String
  titleEn     String
  descFr      String?   @db.Text
  descEn      String?   @db.Text
  startDate   DateTime
  endDate     DateTime? // null or future date = "En cours"
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  title       String
  subtitleFr  String?
  subtitleEn  String?
  resumeFr    String?  @db.Text
  resumeEn    String?  @db.Text
  problemFr   String?  @db.Text
  problemEn   String?  @db.Text
  goalsFr     String[]
  goalsEn     String[]
  solutionFr  String?  @db.Text
  solutionEn  String?  @db.Text
  archFr      String[]
  archEn      String[]
  resultsFr   String[]
  resultsEn   String[]
  categories  String[] // Catégories Technologies
  imageUrl    String?
  linkUrl     String?
  githubUrl   String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
